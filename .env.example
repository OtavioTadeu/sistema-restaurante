# Configurações do Sistema - Dogão do Castelo

# Chave Secreta da Sessão Flask (em produção, use uma chave aleatória forte)
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Banco de Dados
# Para desenvolvimento local (SQLite):
DATABASE_URL=sqlite:///restaurante.db
# Para produção na nuvem (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# Contato do Restaurante
# Telefone para redirecionamento do WhatsApp do pedido (apenas dígitos com DDD e código do país, ex: 5531999999999)
RESTAURANTE_WHATSAPP=553194585341

# Token Secreto para o Agente de Impressão Local
# Deve ser idêntico no servidor na nuvem e no agente_impressao.py na loja
PRINTER_TOKEN=seu-token-secreto-de-impressao-aqui

# Cloudinary (Armazenamento de Imagens dos Pratos na Nuvem)
# Obtenha gratuitamente em https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
